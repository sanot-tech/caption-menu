# 🌐 .gitignore — артефакты сборки и мусор не попадают в репозиторий
# 📦 Выход publish и промежуточные папки
out/
bin/
obj/
# 🎒 Готовый exe, если скопировали в корень
*.exe
*.pdb
*.dll
*.runtimeconfig.json
# 🧪 Логи и временное
*.log
.vs/
*.user
# ⚙️ Идея: положи сюда .idea/ и .vscode/, если не хочешь тащить их в репо
.idea/
.vscode/
