<!--
  Build settings for CaptionMenu.
  Comments explain WHY a setting exists; without the reason a future reader is
  likely to remove a flag that looks redundant.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window. A tray utility that flashes a black console
         on every autostart looks broken to a normal user. -->
    <OutputType>WinExe</OutputType>

    <!-- net9.0-windows: current .NET plus the Windows APIs this tool is built on
         (SetWindowPos, low-level hooks, native menus). -->
    <TargetFramework>net9.0-windows</TargetFramework>

    <!-- WinForms is used ONLY for the tray icon and its context menu. The caption
         menu itself is native Win32, see CaptionMenuPresenter.cs. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Catch null dereferences at compile time instead of at runtime. -->
    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>CaptionMenu</AssemblyName>
    <RootNamespace>CaptionMenu</RootNamespace>

    <!-- PerMonitorV2: the menu must stay crisp on 125/150/200% displays. Without
         this the popup menu is bitmap-scaled and looks blurry. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Self-contained: the exe carries its own runtime, so the tool runs on a
         machine that has never had .NET installed. -->
    <SelfContained>true</SelfContained>

    <!-- Single file: one exe instead of two hundred files, which makes the
         download and the autostart shortcut far less fragile. -->
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- No ICU: we do not localise anything, and trimming it saves about 30 MB. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <DebugType>embedded</DebugType>

    <!-- Application icon. Uncomment once assets/CaptionMenu.ico exists; see
         assets/ICON-PROMPT.md for the Leonardo prompt that generates it. The tray
         code reads the embedded icon and falls back to the system icon, so the
         tool works with or without this line. -->
    <!-- <ApplicationIcon>assets\CaptionMenu.ico</ApplicationIcon> -->

    <!-- Visible in file properties and in "About" dialogs. -->
    <Product>CaptionMenu</Product>
    <AssemblyTitle>CaptionMenu - Always on Top for any window</AssemblyTitle>
    <Description>Right-click any window title bar to pin it on top, like KDE Plasma.</Description>
    <Company>CaptionMenu</Company>
    <Copyright>MIT License</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
