<!-- 🌐 ТАКМЕТА ДЛЯ КОМПИЛЯЦИИ (описание сборки на XML-iru с машинными аннотациями) -->
<Project Sdk="Microsoft.NET.Sdk">
  <!-- 📦 ЭЛЕМЕНТ: WinExe = GUI без чёрной консоли в таскбаре (юзер хочет тихий трей-тул, не консоль) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 🎯 ФРЕЙМВОРК: net9.0-windows = современный .NET + Windows API (SetWindowPos, хуки) -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- 🪟 WINFORMS: нужно только для NotifyIcon (иконка в трее) и контекстного меню трея -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 🔒 NULLABLE: ловим ошибки разыменования на этапе компиляции, а не в рантайме -->
    <Nullable>enable</Nullable>
    <!-- 🧹 IMPLICIT USINGS: меньше мусора using-ов в каждом файле -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 📛 ИМЯ СБОРКИ: CaptionMenu.exe = то, что запускаем и кладём в Startup -->
    <AssemblyName>CaptionMenu</AssemblyName>
    <!-- 📦 ROOT NAMESPACE: папка src\CaptionMenu = корень пространства имён -->
    <RootNamespace>CaptionMenu</RootNamespace>
    <!-- 🖼️ DPI: PerMonitorV2 = меню чёткое на 4K/150%, как в KDE (без мыла) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 🔋 SELF-CONTAINED: .exe тащит рантайм внутрь себя = работает без установленного .NET -->
    <SelfContained>true</SelfContained>
    <!-- 🎒 SINGLE FILE: один .exe вместо 200 файлов = легко копировать/автозапуск -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 🖥️ RID: win-x64 = 64-разрядная Windows 10/11 (эта машина) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 🌐 GLOBALIZATION: не тащим ICU (~30 МБ) — нам не нужны разные Cultures -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 🗜️ СЖАТИЕ: меньший exe -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 🚫 КОНСОЛЬНЫЙ ЛОГ: пишем в Debug-вывод, а не в stdout (иначе будет чёрное окно) -->
    <DebugType>embedded</DebugType>
    <!-- 🎨 ИКОНКА ПРИЛОЖЕНИЯ: путь к .ico (см. assets/ICON-PROMPT.md — промт для Leonardo AI).
         Пока файла нет — строка закомментирована, и тулз работает с иконкой, вшитой компилятором
         по умолчанию. Раскомментируй после генерации иконки. -->
    <!-- <ApplicationIcon>assets\CaptionMenu.ico</ApplicationIcon> -->
    <!-- 🇬🇧 МЕТАДАННЫЕ ПРОЕКТА: видимы в Properties и в информации о файле exe -->
    <Product>CaptionMenu</Product>
    <AssemblyTitle>CaptionMenu — Always on Top for any window</AssemblyTitle>
    <Description>Right-click any window title bar to pin it on top — like KDE Plasma.</Description>
    <Company>CaptionMenu</Company>
    <Copyright>MIT License</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
